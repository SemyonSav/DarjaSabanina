# Публичный адрес сайта (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Папка с данными: база SQLite (site.db) и загруженные картинки (uploads/)
# В продакшене — путь к Docker volume, например /app/data
DATA_DIR=./data

# Администратор
ADMIN_LOGIN=admin
# bcrypt-хеш пароля: npm run admin:hash-password -- "ваш-пароль"
# Знаки $ в хеше экранируйте обратным слэшем: \$2b\$12\$...
ADMIN_PASSWORD_HASH=
# Секрет для подписи сессии (не короче 32 символов): openssl rand -base64 48
AUTH_SECRET=
